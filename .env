
# You can change these so be whatever

EXTREME_BACKEND_PORT=4000
EXTREME_BUILDER_PORT=4010
EXTREME_FRONTEND_PORT=4020
EXTREME_PROXY_PORT=4030

# Front run mode
# This can be dev or start

EXTREME_FRONTEND_MODE=start

# Cloudflared tunnel token

CLOUDFLARED_TOKEN=yourtoken # the one i uploaded by accident no longer works dont use that one

# Your domain

CLOUDFLARED_DOMAIN=yourdomain